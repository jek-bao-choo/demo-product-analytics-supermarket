# Datadog RUM / Product Analytics settings (copy to .env.local and fill in).
# Find these in Datadog: Digital Experience > Manage Applications > <your app>.
# For AWS Amplify, add the same keys under App settings > Environment variables.
NEXT_PUBLIC_DD_APPLICATION_ID=
NEXT_PUBLIC_DD_CLIENT_TOKEN=
NEXT_PUBLIC_DD_REMOTE_CONFIG_ID=
NEXT_PUBLIC_DD_SITE=datadoghq.com
